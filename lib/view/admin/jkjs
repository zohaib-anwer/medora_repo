  Widget _imageMessage(
    ChatMessage message,
    bool selected,
  ) {
    return GestureDetector(
      onLongPress:
          () {
        controller
            .startSelection(
          message.id,
        );
      },

      onTap:
          controller
                  .isSelectionMode
              ? () {
                  controller
                      .selectMessage(
                    message.id,
                  );
                }
              : null,

      child:
          AnimatedContainer(
        duration:
            const Duration(
          milliseconds: 150,
        ),

        margin:
            EdgeInsets.only(
          bottom:
              Get.height * .014,
        ),

        padding:
            EdgeInsets.all(
          selected ? 4 : 0,
        ),

        decoration:
            selected
                ? BoxDecoration(
                    color:
                        blue.withOpacity(
                      .18,
                    ),

